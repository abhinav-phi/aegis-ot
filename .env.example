# AEGIS-OT environment (server-side only; never commit real .env)
AEGIS_OT_ENV=dev
# MUST be changed outside dev (startup refuses the default otherwise)
AEGIS_OT_SECRET_KEY=change-me

DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis_ot

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aegis
MINIO_SECRET_KEY=aegis-secret
MINIO_BUCKET_RAW=aegis-raw
MINIO_BUCKET_ARTIFACTS=aegis-artifacts
# object store backend: "local" (deterministic filesystem, default for dev/tests) | "minio"
AEGIS_OT_OBJECT_STORE=local
AEGIS_OT_LOCAL_OBJECT_ROOT=./.objects

CHROMA_HOST=localhost
CHROMA_PORT=8000
# vector store backend: "local" (deterministic in-process) | "chroma"
AEGIS_OT_VECTOR_STORE=local
AEGIS_OT_LOCAL_VECTOR_ROOT=./.vectors

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# llm backend: "ollama" | "scripted" (deterministic offline stand-in; used by tests/demo)
AEGIS_OT_LLM_BACKEND=scripted

MLFLOW_TRACKING_URI=http://localhost:5001

# Auth
AEGIS_OT_ACCESS_TOKEN_MINUTES=15
AEGIS_OT_REFRESH_TOKEN_DAYS=7
AEGIS_OT_REQUIRE_DISTINCT_APPROVER=true
AEGIS_OT_LOGIN_MAX_ATTEMPTS=5
AEGIS_OT_LOGIN_WINDOW_MINUTES=15

# Bootstrap admin (seed task; required in non-dev)
AEGIS_OT_ADMIN_EMAIL=admin@aegis.local
AEGIS_OT_ADMIN_PASSWORD=change-me-admin-12ch

# Safety
AEGIS_OT_APPROVAL_EXPIRY_HOURS=24
AEGIS_OT_AGENT_MAX_STEPS=12
AEGIS_OT_LLM_TIMEOUT_S=90
